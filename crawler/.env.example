# Copy to crawler/.env and fill in what you need. Empty values count as unset.

# PubMed: contact address (recommended) and an optional key for 10 instead of 3 requests/s
NCBI_ENTREZ_EMAIL=
NCBI_API_KEY=
# Optional: NCBI requests per second; default 5 with a key (our key's limit), 3 without.
# The limit is per key, so machines crawling with the same key at once share it.
NCBI_REQUESTS_PER_SECOND=

# arXiv references: without a key, Semantic Scholar refuses most requests (HTTP 429)
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex: optional; open-access copies of PubMed papers without PMC full text. Without a key,
# everyone on the same IP address shares a small daily budget. https://openalex.org/settings/api
OPENALEX_API_KEY=

# YouTube: required for `crawler youtube`
YOUTUBE_API_KEY=

# PostgreSQL: required for --store, e.g.
# postgresql://amos:<password>@127.0.0.1:5432/patient_journey_matcher (values from the root .env)
DATABASE_URL=

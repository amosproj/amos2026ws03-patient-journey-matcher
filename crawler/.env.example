# Copy to crawler/.env and fill in what you need. Empty values count as unset.

# PubMed: contact address (recommended) and an optional key for 10 instead of 3 requests/s
NCBI_ENTREZ_EMAIL=
NCBI_API_KEY=

# arXiv references: without a key, Semantic Scholar refuses most requests (HTTP 429)
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# YouTube: required for `crawler youtube`
YOUTUBE_API_KEY=

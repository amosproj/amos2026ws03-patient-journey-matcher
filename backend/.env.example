# Copy this file to backend/.env and fill in real values. .env is gitignored.
# The API, the workers and the scrapers all read this one file: python-dotenv
# searches upwards from the module that loads it until it finds backend/.env.
#
# Lines that are commented out are optional and show the default from the code.
# Nothing here is needed to install the backend or run its tests (uv run pytest).

# ── Firebase / Firestore (API, workers) ───────────────────────────────────────
FIREBASE_PROJECT_ID=amos26
# Service-account key, relative to backend/. Never commit the key file.
FIREBASE_KEY_RELATIVE_PATH=secrets/firebase-adminsdk.json
# FIREBASE_DATABASE_URL=https://amos26-default-rtdb.europe-west1.firebasedatabase.app/
# Set either one to use the local Firebase emulators instead of the key file.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ── Google Cloud Storage ──────────────────────────────────────────────────────
# Documents bucket. The API (shared/gcs.py) reads GCS_BUCKET_NAME, the workers
# read GCS_DOCUMENTS_BUCKET, so set both to the same bucket.
GCS_BUCKET_NAME=...
GCS_DOCUMENTS_BUCKET=...
GCS_CYPHER_BUCKET=...           # exported Cypher graph files (workers write)
# GCS_SIGNED_URL_TTL_SECONDS=900

# ── Pub/Sub (API publishes, workers receive pushes) ───────────────────────────
# PUBSUB_TOPIC_DOCUMENT_UPLOADED=document-uploaded
PUBSUB_PUSH_AUDIENCE=...        # OIDC audience of the push subscription
PUBSUB_PUSH_SERVICE_ACCOUNT=... # service account the push requests come from
# PUBSUB_SKIP_OIDC_VERIFICATION=1   # local emulator only

# ── Vertex AI (Gemini LLM, embeddings, ranking) ───────────────────────────────
# Auth uses Application Default Credentials, no API key:
#   Local: gcloud auth application-default login
#   GCP:   the service account needs roles/aiplatform.user and roles/discoveryengine.viewer
VERTEX_PROJECT=amos26
VERTEX_LOCATION=us-central1
# VERTEX_LLM_MODEL=gemini-2.0-flash-001
# VERTEX_EMBEDDING_MODEL=text-embedding-005
# VERTEX_RANKING_LOCATION=global
# VERTEX_RANKING_CONFIG_ID=default_ranking_config

# ── Neo4j (knowledge graph) ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687   # local Docker, or neo4j+s://xxxx.databases.neo4j.io (Aura)
NEO4J_USER=neo4j
NEO4J_PASSWORD=...
# NEO4J_DATABASE=neo4j

# ── OpenAI + AstraDB vector store (scrapers write, API reads) ─────────────────
# OPENAI_EMBEDDING_MODEL must match the model the scrapers embed with
# (scrapers/src/backend/Scrapers/BaseScraper/base_scraper.py). With a different
# model, retrieval silently returns unrelated papers.
OPEN_AI_API=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_TOKEN=AstraCS:...
ASTRA_DB_NAMESPACE=default_keyspace
ASTRA_DB_COLLECTION=health_ai

# ── Scraper sources ───────────────────────────────────────────────────────────
NCBI_EMAIL=you@example.com      # optional; NCBI asks PubMed callers to identify themselves
NCBI_API_KEY=                   # optional; raises the PubMed rate limit
YOUTUBE_DATA_API_V3=            # only for YouTube scraping
YOUTUBE_INNERTUBE_KEY=          # only for YouTube transcripts

# ── Monthly scraper job (scrapers/run_monthly.py) ─────────────────────────────
# STATE_BUCKET=                 # GCS bucket with the dedup state; empty re-scrapes everything
# SCRAPER_TARGETS=pubmed archive
# RUN_YOUTUBE=1
# MAX_RESULTS=5
# YOUTUBE_LIMIT=25
# DOMAIN=medical
# SUB_DOMAIN=oncology
# KEYWORDS_DIR=scrapers/key_words
# SINCE_DATE=                   # YYYY-MM-DD; default is the start of last month

# ── Tuning (API chat pipeline, workers) ───────────────────────────────────────
# CHAT_PAPER_DOMAIN=medical
# CHAT_PAPER_SUB_DOMAIN=oncology
# CHAT_PAPER_VECTOR_TOP_K=4
# CHAT_PAPER_RERANK_TOP_N=2
# CHAT_PAPER_RERANK_MODEL=semantic-ranker-default@latest
# CHAT_PAPER_VECTOR_TIMEOUT_S=8.0
# CHAT_PAPER_RERANK_TIMEOUT_S=8.0
# CHAT_PAPER_MAX_QUERY_CHARS=2000
# CHAT_RETRIEVE_NUM_RESULTS=4
# CHAT_RETRIEVE_TIMEOUT_S=15.0
# CHAT_RETRIEVE_MAX_QUERY_CHARS=2000
# CHAT_UNAVAILABLE_COOLDOWN_S=60.0
# CHAT_GRAPHITI_WARMUP=         # set to warm up Graphiti on API startup
# LLM_CALL_TIMEOUT_S=120
# GEMINI_PACER_MIN_INTERVAL_S=0.5
# GEMINI_MAX_OUTPUT_TOKENS=65536

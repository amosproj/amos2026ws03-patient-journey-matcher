# Copy this file to tools/patient-graph/.env and fill in the key. .env is gitignored.
# Lines that are commented out are optional and show the default from the code.

# API key from Google AI Studio (https://aistudio.google.com/apikey); a free key works,
# but allows only some documents per day.
GEMINI_API_KEY=...

# VERTEX_LLM_MODEL=gemini-2.5-flash
# GEMINI_PACER_MIN_INTERVAL_S=0.5   # pause between two calls of Graphiti's LLM
# GEMINI_MAX_OUTPUT_TOKENS=65536
# LLM_CALL_TIMEOUT_S=120
